{
  "id": "10000000-0000-0000-0000-000000000011",
  "tenant_id": "mobile",
  "namespace": "default",
  "name": "field-inspection-offline",
  "version": 1,
  "deprecated": false,
  "blocks": [
    {
      "type": "step",
      "id": "capture_checklist",
      "handler": "inspection_form",
      "params": { "form": "checklist", "template": "site-safety-v1" },
      "cancellable": true,
      "wait_for_input": {
        "prompt": "Complete the site checklist.",
        "timeout": 604800000,
        "choices": [{ "label": "Checklist complete", "value": "complete" }],
        "store_as": "checklist_status"
      }
    },
    {
      "type": "step",
      "id": "capture_photos",
      "handler": "inspection_form",
      "params": { "form": "photos", "min_photos": 1, "max_photos": 8 },
      "cancellable": true,
      "wait_for_input": {
        "prompt": "Attach photo evidence.",
        "timeout": 604800000,
        "choices": [
          { "label": "Photos attached", "value": "attached" },
          { "label": "Photos not possible on site", "value": "none" }
        ],
        "store_as": "evidence_status"
      }
    },
    {
      "type": "step",
      "id": "inspector_attestation",
      "handler": "inspection_form",
      "params": { "form": "attestation" },
      "cancellable": true,
      "wait_for_input": {
        "prompt": "Submit this inspection for supervisor review?",
        "timeout": 604800000,
        "choices": [{ "label": "Submit for review", "value": "submitted" }],
        "store_as": "attestation"
      }
    },
    {
      "type": "step",
      "id": "queue_evidence_upload",
      "handler": "queue_evidence_upload",
      "params": { "record_type": "inspection" },
      "cancellable": true
    },
    {
      "type": "step",
      "id": "supervisor_approval",
      "handler": "human_review",
      "params": {
        "reviewer": "site-supervisor",
        "instructions": "Review the checklist and photo evidence, then approve, request changes, or reject."
      },
      "cancellable": true,
      "wait_for_input": {
        "prompt": "Supervisor approval required for this inspection.",
        "timeout": 604800000,
        "choices": [
          { "label": "Approve", "value": "approved" },
          { "label": "Request changes", "value": "changes_requested" },
          { "label": "Reject", "value": "rejected" }
        ],
        "store_as": "supervisor_decision",
        "allow_comment": true
      }
    },
    {
      "type": "router",
      "id": "route_supervisor_decision",
      "routes": [
        {
          "condition": "context.data.supervisor_decision == \"approved\"",
          "blocks": [
            { "type": "step", "id": "finalize_report", "handler": "finalize_report", "params": {}, "cancellable": true }
          ]
        },
        {
          "condition": "context.data.supervisor_decision == \"changes_requested\"",
          "blocks": [
            {
              "type": "step",
              "id": "notify_changes_requested",
              "handler": "notify_inspector",
              "params": { "outcome": "changes_requested" },
              "cancellable": true
            }
          ]
        }
      ],
      "default": [
        {
          "type": "step",
          "id": "notify_rejected",
          "handler": "notify_inspector",
          "params": { "outcome": "rejected" },
          "cancellable": true
        }
      ]
    }
  ],
  "created_at": "2026-09-26T00:00:00Z"
}
