# Copy to .env and fill in. EXPO_PUBLIC_* values are embedded in the app bundle.
# Leave EXPO_PUBLIC_ORCH8_URL empty to run fully offline (demo mode).
EXPO_PUBLIC_ORCH8_URL=https://orch8.example.com
EXPO_PUBLIC_ORCH8_TENANT=mobile
# Device-scoped, least-privilege key. Never an admin key.
EXPO_PUBLIC_ORCH8_DEVICE_KEY=
EXPO_PUBLIC_SUPERVISOR_ID=site-supervisor
# Optional: PUT {url}/{sha256} evidence store. Empty = photos never leave the device.
EXPO_PUBLIC_EVIDENCE_UPLOAD_URL=
EXPO_PUBLIC_INSPECTOR_NAME=Field inspector
